# Set these only in Firebase Functions / CI. Do not add them to VITE_* variables.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# OpenDART → 인증키 신청/관리에서 발급 (국내 연간 재무제표)
DART_API_KEY=
# SEC 연간 재무제표: 앱/운영자 이름과 연락 이메일 (API 키 아님)
# 예: SEC_USER_AGENT="PortfolioApp your-email@example.com"
SEC_USER_AGENT=
EODHD_API_TOKEN=
# NAVER API HUB → 검색(Search) API 이용 신청 후 발급한 Client ID / Client Secret
# 기존 NAVER Developers 검색 API 키가 아닌 API HUB 키를 입력합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MARKETAUX_API_TOKEN=
